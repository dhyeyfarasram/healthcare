<odoo>

    <record id="action_report_patient_visit" model="ir.actions.report">
        <field name="name">Visit Receipt</field>
        <field name="model">patient.visit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">patients.report_patient_visit_receipt</field>
        <field name="report_file">patients.report_patient_visit_receipt</field>
        <field name="print_report_name">'Visit Receipt - %s' % (object.name)</field>
    </record>

    <template id="report_patient_visit_receipt">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="doc">
                <main>
            <div class="page">

                <h2 class="text-center">Visit Receipt</h2>

                <br/>

                <!-- Visit Info -->
                <table class="table table-sm">
                    <tr>
                        <td><strong>Patient Name:</strong></td>
                        <td><t t-esc="doc.patient_id.name"/></td>
                    </tr>
                    <tr>
                        <td><strong>Visit Date:</strong></td>
                        <td><t t-esc="doc.visit_date"/></td>
                    </tr>
                    <tr>
                        <td><strong>Doctor:</strong></td>
                        <td><t t-esc="doc.doctor_id.name"/></td>
                    </tr>
                    <tr>
                        <td><strong>Payment Method:</strong></td>
                        <td>
                            <t t-esc="doc.payment_reference or 'N/A'"/>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Total Amount:</strong></td>
                        <td>
                            <t t-esc="doc.token_amount"/> USD
                        </td>
                    </tr>
                </table>

                <br/>

                <!-- Prescription -->
                <h4>Prescription Details</h4>

                <t t-if="doc.prescription_line_ids">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Medicine</th>
                                <th>Dosage</th>
                                <th>Instructions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.prescription_line_ids" t-as="line">
                                <tr>
                                    <td><t t-esc="line.medicine_id.name"/></td>
                                    <td><t t-esc="line.dosage"/></td>
                                    <td><t t-esc="line.instructions"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <t t-else="">
                    <p>No prescriptions available.</p>
                </t>

            </div>
                </main>
            </t>
        </t>
    </template>

</odoo>