<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="action_doctor_department_doctors" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('department_id', '=', active_id)]</field>
    </record>


    <record id="action_doctor_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">doctor.department</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="view_doctor_department_list" model="ir.ui.view">
        <field name="name">doctor.department.list</field>
        <field name="model">doctor.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="doctor_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <record id="view_doctor_department_form" model="ir.ui.view">
        <field name="name">doctor.department.form</field>
        <field name="model">doctor.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_doctor_department_doctors)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-user-md">
                            <field name="doctor_count" widget="statinfo" string="Doctors"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Doctors">
                        <field name="doctor_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="email"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>



    <record id="view_users_form_inherit_department" model="ir.ui.view">
        <field name="name">res.users.form.department</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="department_id"
                       groups="patients.group_patient_administrator"/>
            </xpath>
        </field>
    </record>


    <record id="view_patient_visit_form_department" model="ir.ui.view">
        <field name="name">patient.visit.form.department</field>
        <field name="model">patient.visit</field>
        <field name="inherit_id" ref="patients.view_patient_visit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='doctor_id']" position="after">
                <field name="doctor_department_id" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>