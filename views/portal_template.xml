<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         My Appointments List Page
    ============================================================ -->
    <template id="portal_my_appointments" name="My Appointments">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Appointments</t>
            </t>

            <t t-if="not visits">
                <div class="alert alert-warning mt-3">
                    You have no appointments yet.
                    <a href="/my/appointments/new" class="alert-link">Book one now</a>.
                </div>
            </t>

            <t t-if="visits">
                <div class="card mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Appointments</span>
                        <a href="/my/appointments/new" class="btn btn-sm btn-primary">
                            + Book Appointment
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover o_portal_my_doc_table mb-0">
                            <thead>
                                <tr class="active">
                                    <th>Reference</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Doctor</th>
                                    <th>Status</th>
                                    <th>Receipt</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="visits" t-as="visit">
                                    <tr>
                                        <td>
                                            <a t-att-href="'/my/appointments/%s' % visit.id">
                                                <t t-esc="visit.name"/>
                                            </a>
                                        </td>
                                        <td>
                                            <span t-field="visit.visit_date"/>
                                        </td>
                                        <td>
                                            <t t-esc="dict(visit._fields['visit_time'].selection).get(visit.visit_time, visit.visit_time)"/>
                                        </td>
                                        <td>
                                            <t t-esc="visit.doctor_id.name"/>
                                        </td>
                                        <td>
                                            <t t-if="visit.state == 'pending_payment'">
                                                <span class="badge rounded-pill text-bg-warning">Pending Payment</span>
                                            </t>
                                            <t t-elif="visit.state == 'scheduled'">
                                                <span class="badge rounded-pill text-bg-info">Scheduled</span>
                                            </t>
                                            <t t-elif="visit.state == 'completed'">
                                                <span class="badge rounded-pill text-bg-success">Completed</span>
                                            </t>
                                            <t t-elif="visit.state == 'cancelled'">
                                                <span class="badge rounded-pill text-bg-danger">Cancelled</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge rounded-pill text-bg-secondary">
                                                    <t t-esc="visit.state"/>
                                                </span>
                                            </t>
                                        </td>
                                        <td>
                                            <a t-att-href="'/my/patient/visit/%s/receipt' % visit.id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fa fa-download"/> Receipt
                                            </a>
                                        </td>
                                        <td>
                                            <t t-if="visit.state not in ('cancelled', 'completed')">
                                                <a t-att-href="'/my/appointments/cancel/%s' % visit.id"
                                                   class="btn btn-sm btn-outline-danger"
                                                   onclick="return confirm('Are you sure you want to cancel this appointment?')">
                                                    <i class="fa fa-times me-1"/> Cancel
                                                </a>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted small">—</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pager -->
                    <div t-if="pager" class="o_portal_pager text-center mt-3">
                        <t t-call="portal.pager"/>
                    </div>
                </div>
            </t>
        </t>
    </template>


    <!-- ============================================================
         Visit Detail Page
    ============================================================ -->
    <template id="portal_visit_detail" name="Visit Detail">
        <t t-call="portal.portal_layout">

            <nav class="o_portal_navbar navbar navbar-light border-bottom px-3 py-2 bg-white">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/my/home">My Account</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="/my/appointments">My Appointments</a>
                    </li>
                    <li class="breadcrumb-item active">
                        <t t-esc="visit.name"/>
                    </li>
                </ol>
            </nav>

            <div class="container mt-4">
                <div class="row">

                    <!-- Main Content -->
                    <div class="col-lg-9">

                        <!-- Visit Info Card -->
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><t t-esc="visit.name"/></h5>
                                <t t-if="visit.state == 'pending_payment'">
                                    <span class="badge rounded-pill text-bg-warning">Pending Payment</span>
                                </t>
                                <t t-elif="visit.state == 'scheduled'">
                                    <span class="badge rounded-pill text-bg-info">Scheduled</span>
                                </t>
                                <t t-elif="visit.state == 'completed'">
                                    <span class="badge rounded-pill text-bg-success">Completed</span>
                                </t>
                                <t t-elif="visit.state == 'cancelled'">
                                    <span class="badge rounded-pill text-bg-danger">Cancelled</span>
                                </t>
                            </div>
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-md-4">
                                        <strong>Date:</strong>
                                        <span t-field="visit.visit_date"/>
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Time:</strong>
                                        <t t-esc="dict(visit._fields['visit_time'].selection).get(visit.visit_time, visit.visit_time)"/>
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Doctor:</strong>
                                        <t t-esc="visit.doctor_id.name"/>
                                    </div>
                                </div>
                                <t t-if="visit.notes">
                                    <hr/>
                                    <strong>Notes:</strong>
                                    <p class="mt-1 mb-0"><t t-esc="visit.notes"/></p>
                                </t>
                            </div>
                        </div>

                        <!-- Prescription History -->
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5 class="mb-0">Prescription History</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="visit.prescription_line_ids">
                                    <table class="table table-bordered mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Medicine</th>
                                                <th>Dosage</th>
                                                <th>Instructions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="visit.prescription_line_ids" t-as="line">
                                                <tr>
                                                    <td><t t-esc="line.medicine_id.name"/></td>
                                                    <td><t t-esc="line.dosage"/></td>
                                                    <td><t t-esc="line.instructions"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted mb-0">No prescriptions found.</p>
                                </t>
                            </div>
                        </div>

                    </div>

                    <!-- Sidebar -->
                    <div class="col-lg-3">
                        <div class="card mb-3">
                            <div class="card-body">
                                <h6 class="card-title">Actions</h6>
                                <div class="d-grid gap-2">

                                    <t t-if="visit.state == 'pending_payment'">
                                        <a t-att-href="'/my/appointments/pay/%s' % visit.id"
                                           class="btn btn-warning btn-sm">
                                            <i class="fa fa-credit-card me-1"/> Pay Now
                                        </a>
                                    </t>

                                    <a t-att-href="'/my/patient/visit/%s/receipt' % visit.id"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="fa fa-download me-1"/> Download Receipt
                                    </a>

                                    <t t-if="visit.state not in ('cancelled', 'completed')">
                                        <a t-att-href="'/my/appointments/cancel/%s' % visit.id"
                                           class="btn btn-outline-danger btn-sm"
                                           onclick="return confirm('Are you sure you want to cancel this appointment?')">
                                            <i class="fa fa-times me-1"/> Cancel Appointment
                                        </a>
                                    </t>

                                    <a href="/my/appointments" class="btn btn-outline-secondary btn-sm">
                                        <i class="fa fa-arrow-left me-1"/> Back to Appointments
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </t>
    </template>


    <!-- ============================================================
         Payment Page
    ============================================================ -->
    <template id="portal_payment_page">
        <t t-call="portal.portal_layout">

            <nav class="o_portal_navbar navbar navbar-light border-bottom px-3 py-2 bg-white">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                    <li class="breadcrumb-item"><a href="/my/appointments">My Appointments</a></li>
                    <li class="breadcrumb-item active">Payment</li>
                </ol>
            </nav>

            <div class="container mt-4">
                <div class="row justify-content-center">
                    <div class="col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Complete Payment</h5>
                            </div>
                            <div class="card-body">
                                <p><strong>Visit:</strong> <t t-esc="visit.name"/></p>
                                <p><strong>Doctor:</strong> <t t-esc="visit.doctor_id.name"/></p>
                                <p>
                                    <strong>Date:</strong>
                                    <span t-field="visit.visit_date"/>
                                </p>
                                <p>
                                    <strong>Time:</strong>
                                    <t t-esc="dict(visit._fields['visit_time'].selection).get(visit.visit_time, visit.visit_time)"/>
                                </p>
                                <hr/>
                                <p class="fs-5">
                                    <strong>Amount Due:</strong>
                                    <t t-esc="visit.token_amount"/> USD
                                </p>
                                <form t-att-action="'/my/appointments/confirm_payment/%s' % visit.id" method="get">
                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-success">
                                            <i class="fa fa-credit-card me-1"/> Pay Now
                                        </button>
                                        <a t-att-href="'/my/appointments/cancel/%s' % visit.id"
                                           class="btn btn-outline-danger"
                                           onclick="return confirm('Are you sure you want to cancel this appointment?')">
                                            <i class="fa fa-times me-1"/> Cancel Appointment
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </t>
    </template>


    <!-- ============================================================
         New Appointment Form
    ============================================================ -->

<template id="portal_appointment_form" name="New Appointment">
    <t t-call="portal.portal_layout">

        <nav class="o_portal_navbar navbar navbar-light border-bottom px-3 py-2 bg-white">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                <li class="breadcrumb-item"><a href="/my/appointments">My Appointments</a></li>
                <li class="breadcrumb-item active">New Appointment</li>
            </ol>
        </nav>

        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Book an Appointment</h5>
                        </div>
                        <div class="card-body">

                            <!-- Error Message -->
                            <t t-if="error">
                                <div class="alert alert-danger d-flex align-items-center mb-3">
                                    <i class="fa fa-exclamation-circle me-2"/>
                                    <span><t t-esc="error"/></span>
                                </div>
                            </t>

                            <!-- Step 1: Filter by Department -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">
                                    <i class="fa fa-hospital-o me-1"/>
                                    Filter by Department
                                    <small class="text-muted fw-normal">(optional)</small>
                                </label>
                                <div class="d-flex flex-wrap gap-2">
                                    <a href="/my/appointments/new"
                                       t-attf-class="btn btn-sm #{'btn-primary' if not selected_department_id else 'btn-outline-secondary'}">
                                        All Departments
                                    </a>
                                    <t t-foreach="departments" t-as="dept">
                                        <a t-attf-href="/my/appointments/new?department_id=#{dept.id}"
                                           t-attf-class="btn btn-sm #{'btn-primary' if selected_department_id == dept.id else 'btn-outline-secondary'}">
                                            <t t-esc="dept.name"/>
                                        </a>
                                    </t>
                                </div>
                            </div>

                            <form action="/my/appointments/create" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <t t-if="selected_department_id">
                                    <input type="hidden" name="department_id" t-att-value="selected_department_id"/>
                                </t>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Doctor</label>
                                    <select name="doctor_id" class="form-select" required="1">
                                        <option value="">
                                            <t t-if="selected_department_id">
                                                Select a Doctor from this department
                                            </t>
                                            <t t-else="">
                                                Select a Doctor
                                            </t>
                                        </option>
                                        <t t-foreach="doctors" t-as="doc">
                                            <option t-att-value="doc.id">
                                                <t t-esc="doc.name"/>
                                                <t t-if="doc.department_id">
                                                    — <t t-esc="doc.department_id.name"/>
                                                </t>
                                            </option>
                                        </t>
                                    </select>
                                    <t t-if="not doctors">
                                        <div class="form-text text-danger">
                                            No doctors available in this department.
                                        </div>
                                    </t>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Appointment Date</label>
                                    <input type="date" name="visit_date" class="form-control"
                                           required="1" t-att-min="min_date"/>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Appointment Time</label>
                                    <select name="visit_time" class="form-select" required="1">
                                        <option value="">Select a time slot</option>
                                        <t t-foreach="time_slots" t-as="slot">
                                            <option t-att-value="slot['value']">
                                                <t t-esc="slot['label']"/>
                                            </option>
                                        </t>
                                    </select>
                                    <div class="form-text text-muted">
                                        Each slot is 30 minutes. Slots run from 08:00 to 18:00.
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Notes</label>
                                    <textarea name="notes" class="form-control" rows="3"
                                              placeholder="Describe your symptoms or reason for visit..."/>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        Medical Report
                                        <small class="text-muted fw-normal">(PDF, JPG or PNG)</small>
                                    </label>
                                    <input type="file" name="report" class="form-control"
                                           accept=".pdf,.jpg,.png"/>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary"
                                            t-att-disabled="'disabled' if not doctors else None">
                                        <i class="fa fa-calendar-check-o me-1"/> Submit
                                    </button>
                                    <a href="/my/appointments" class="btn btn-outline-secondary">
                                        Cancel
                                    </a>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </t>
</template>


    <!-- ============================================================
         Show patient in account details
    ============================================================ -->
    <template id="portal_my_details_inherit" inherit_id="portal.portal_my_details">
        <xpath expr="//div[contains(@class, 'row')]" position="inside">
            <div class="col-12">
                <p>
                    <strong>Patient:</strong>
                    <t t-esc="request.env.user.name"/>
                </p>
            </div>
        </xpath>
    </template>


    <!-- ============================================================
         Portal Home Card
    ============================================================ -->
    <template id="portal_my_home_inherit" inherit_id="portal.portal_my_home">
        <xpath expr="//div[contains(@class, 'o_portal_my_home')]" position="inside">
            <div class="o_portal_index_card col-md-6 order-2">
                <a href="/my/appointments" title="My Appointments"
                   class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div class="o_portal_icon d-block align-self-start">
                        <img src="/portal/static/src/img/portal-calander.svg" loading="lazy"/>
                    </div>
                    <div class="">
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                            <span>My Appointments</span>
                        </div>
                        <div class="opacity-75">
                            View, book or manage your appointments
                        </div>
                    </div>
                    <span class="badge badge-pill badge-primary">
                        <t t-esc="visit_count"/>
                    </span>
                </a>
            </div>
        </xpath>
    </template>

</odoo>